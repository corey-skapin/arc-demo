// include: candidates
// Machines with no telemetry in the window, or silent for more than a day before it ends. Stale is not redundant and never means safe to delete.
Candidates
| where StaleState == "Flagged"
| extend SilentFor = iff(isnull(SilentHours), "no sample in window", strcat(tostring(SilentHours), " h"))
| sort by Machine asc
| project Machine, Topology, Os, Environment, State = ReportingState, SilentFor, LastSample = HostLastSeen, Evidence = EvidenceState,
    Reading = iff(AnyTelemetry, "Telemetry stopped. Verify power state and the agent before drawing any conclusion.",
        "No telemetry in this window. Check Arc state, the DCR association and power state; absence is unknown, not unused.")
