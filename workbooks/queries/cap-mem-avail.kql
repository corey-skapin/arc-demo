// include: series
// Lowest available memory (MB) per machine and interval. Absolute amounts are not comparable across different machine sizes. Gaps stay null.
Samples
| where Metric == "Available MB" and isnotnull(Value)
| lookup kind=inner (Machines | project ResourceId, Machine) on ResourceId
| make-series LowestAvailableMB = min(Value) default = real(null) on TimeGenerated from bin(WindowStart, BarStep) to bin(WindowEnd, BarStep) + BarStep step BarStep by Machine
