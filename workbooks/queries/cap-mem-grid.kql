// include: hosts
// Memory evidence per machine. The Windows measure (committed bytes in use) and the Linux measure (used memory) are different
// counters on one scale; each row keeps its own basis and is never blended with another counter.
let Trends = Samples
| where Metric == "Memory percent" and isnotnull(Value)
| summarize P95 = percentile(Value, 95) by ResourceId, Bin = bin(TimeGenerated, Step)
| sort by ResourceId asc, Bin asc
| summarize MemTrend = make_list(round(P95, 1)) by ResourceId;
Hosts
| lookup kind=leftouter Trends on ResourceId
| extend Basis = case(tostring(MemSources) has "Committed", "Committed bytes (Windows)", tostring(MemSources) has "Used Memory", "Used memory (Linux)", "not reported"),
    MemState = case(not(HasMem), "Missing - not zero", MemSustained, "Sustained pressure", MemObservedHours < MinObservedHours, "Thin history", coalesce(MemMax, 0.0) >= MemHigh, "Brief peak", "Within threshold")
| sort by HasMem desc, MemP95 desc, Machine asc
| project Machine, Basis, State = MemState, Mean = round(MemMean, 1), P95 = round(MemP95, 1), Peak = round(MemMax, 1), MemTrend,
    LowestAvailableMB = round(AvailMbMin, 0)
