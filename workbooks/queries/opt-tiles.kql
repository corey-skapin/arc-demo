// include: candidates
// Opportunity summary, first row: machines reviewed and the three review reasons that are conversations about the machine itself.
// These are conversation starters, not approved savings. Tile text stays short; the candidates table lists every machine.
let Counts = Candidates
| summarize Total = count(), Guests = countif(Layer == "guest"),
    Under = countif(UnderState == "Flagged"), UnderList = make_list_if(Machine, UnderState == "Flagged", 50),
    Scheduling = countif(SchedulingState == "Flagged"), SchedulingList = make_list_if(Machine, SchedulingState == "Flagged", 50),
    Consolidation = countif(ConsolidationState == "Flagged"), ConsolidationList = make_list_if(Machine, ConsolidationState == "Flagged", 50)
| extend K = 1;
let ShortList = (names:dynamic) {
    let sorted = array_sort_asc(names);
    let n = array_length(sorted);
    let both = strcat_array(sorted, ", ");
    case(n == 0, "none", n == 1, tostring(sorted[0]), n == 2 and strlen(both) <= 20, both, strcat(tostring(sorted[0]), " +", tostring(n - 1)))
};
datatable(SortKey:long, Label:string)[
    0, "🖥️ Machines reviewed",
    1, "📉 Low utilisation",
    2, "🕒 Scheduling",
    3, "🧩 Consolidation"]
| extend K = 1
| join kind=inner Counts on K
| project SortKey, Label,
    Value = case(SortKey == 0, Total, SortKey == 1, Under, SortKey == 2, Scheduling, Consolidation),
    Note = case(
        SortKey == 0, iff(Guests > 0, strcat(tostring(Guests), iff(Guests == 1, " guest", " guests"), ", counted once"), "all independent"),
        SortKey == 1, ShortList(UnderList), SortKey == 2, ShortList(SchedulingList), ShortList(ConsolidationList))
| sort by SortKey asc
| project Label, Value, Note
