// include: series
// Selected machine: memory in use per interval (mean and peak). Gaps stay null.
Samples
| where Metric == "Memory percent" and isnotnull(Value)
| lookup kind=inner (Machines | project ResourceId, Machine) on ResourceId
| where Machine == '{SelectedHost}'
| make-series Mean = avg(Value) default = real(null), Peak = max(Value) default = real(null)
    on TimeGenerated from bin(WindowStart, Step) to bin(WindowEnd, Step) + Step step Step
