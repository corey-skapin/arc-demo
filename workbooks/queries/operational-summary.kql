// include: series
// Per host/metric/instance evidence: statistics plus how much of the window each series actually covers.
// Needs: Samples (operational-series), Machines, WindowStart, WindowEnd, MinObservedHours.
// Observed hours are real sampled minutes; parked gaps are unknown time, never idle headroom.
let WindowMinutes = datetime_diff("minute", bin(WindowEnd, 1m), bin(WindowStart, 1m)) + 1;
let Observed = Samples
| summarize Samples = countif(isnotnull(Value)), InvalidSamples = countif(Invalid),
    Mean = avg(Value), P95 = percentile(Value, 95), Maximum = max(Value), Minimum = min(Value),
    BreachMinutes = countif(Breach == true),
    FirstSeen = minif(TimeGenerated, isnotnull(Value)), LastSeen = maxif(TimeGenerated, isnotnull(Value)),
    Sources = make_set(Source, 4)
    by ResourceId, Metric, Instance;
let Minutes = Samples
| where isnotnull(Value)
| summarize by ResourceId, Metric, Instance, Minute = bin(TimeGenerated, 1m)
| summarize ObservedMinutes = count() by ResourceId, Metric, Instance;
let ActiveBins = Samples
| where isnotnull(Value)
| summarize by ResourceId, Metric, Instance, FiveMinutes = bin(TimeGenerated, 5m)
| summarize ActiveBins = count() by ResourceId, Metric, Instance;
let Edges = Samples
| where isnotnull(Value)
| summarize arg_min(TimeGenerated, Value), arg_max(TimeGenerated, Value) by ResourceId, Metric, Instance
| project ResourceId, Metric, Instance, FirstValue = Value, LastValue = Value1;
let HostSeen = Samples
| where isnotnull(Value)
| summarize HostFirstSeen = min(TimeGenerated), HostLastSeen = max(TimeGenerated) by ResourceId;
let Expected = Machines | extend JoinKey = 1
| join kind=inner (datatable(Metric:string)["CPU percent", "Memory percent", "Available MB", "Disk free percent"] | extend JoinKey = 1) on JoinKey
| project ResourceId, Machine, Layer, ParentResourceId, Os, Environment, Application, Metric;
let Summary = materialize(Expected
| join kind=leftouter Observed on ResourceId, Metric
| join kind=leftouter Minutes on ResourceId, Metric, Instance
| join kind=leftouter ActiveBins on ResourceId, Metric, Instance
| join kind=leftouter Edges on ResourceId, Metric, Instance
| lookup kind=leftouter HostSeen on ResourceId
| extend Mean = iff(isnan(Mean), real(null), Mean)
| extend ObservedHours = round(coalesce(ObservedMinutes, 0) / 60.0, 1),
    CoveragePercent = round(100.0 * coalesce(ObservedMinutes, 0) / WindowMinutes, 1),
    SamplingPct = iff(coalesce(ActiveBins, 0) == 0, real(null), round(min_of(100.0, 100.0 * ObservedMinutes / (5.0 * ActiveBins)), 0)),
    AgeMinutes = datetime_diff("minute", WindowEnd, LastSeen),
    Delta = round(LastValue - FirstValue, 1)
| extend Evidence = case(
    InvalidSamples > 0, "Invalid samples - investigate",
    isnull(Samples) or Samples == 0, "Missing data - not zero",
    ObservedHours < MinObservedHours, "Thin history",
    SamplingPct < 80, "Sparse sampling while active",
    AgeMinutes > 15, "Adequate - not reporting now",
    "Adequate")
| extend VolumeState = case(Metric != "Disk free percent" or isnull(LastSeen), "", LastSeen >= HostLastSeen - 30m, "Reporting", "No longer reported")
| project ResourceId, Machine, Layer, ParentResourceId, Os, Environment, Application, Metric, Instance, VolumeState,
    Mean, P95, Maximum, Minimum, FirstValue, LastValue, Delta, Samples, InvalidSamples, BreachMinutes,
    ObservedMinutes, ObservedHours, SamplingPct, CoveragePercent, FirstSeen, LastSeen, AgeMinutes, Evidence, Sources);
