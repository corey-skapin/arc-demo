// include: summary
// Per-volume evidence. Free percent alone supports a free-space trend, not consumption rate or an exhaustion date.
// Size is reported by VM insights (Windows) or derived from free MB / free percent (Linux); blank when neither is available.
let FreeMb = Samples
| where Metric == "Disk free MB" and isnotnull(Value)
| summarize arg_max(TimeGenerated, Value) by ResourceId, Instance
| project ResourceId, Instance, FreeMbNow = Value;
let SizeReported = InsightsMetrics
| where TimeGenerated between (WindowStart .. WindowEnd) and Origin == "vm.azm.ms" and Namespace == "LogicalDisk" and Name == "FreeSpaceMB"
| extend ResourceId = tolower(_ResourceId)
| where ResourceId in (Machines | project ResourceId)
| extend Instance = tostring(todynamic(Tags)["vm.azm.ms/mountId"]), SizeMb = todouble(todynamic(Tags)["vm.azm.ms/diskSizeMB"])
| where isnotempty(Instance) and isnotnull(SizeMb)
| summarize arg_max(TimeGenerated, SizeMb) by ResourceId, Instance
| project ResourceId, Instance, SizeMb;
let Trends = Samples
| where Metric == "Disk free percent" and isnotnull(Value)
| summarize Free = avg(Value) by ResourceId, Instance, Bin = bin(TimeGenerated, Step)
| sort by ResourceId asc, Instance asc, Bin asc
| summarize FreeTrend = make_list(round(Free, 1)) by ResourceId, Instance;
Summary
| where Metric == "Disk free percent" and Samples > 0
| lookup kind=leftouter FreeMb on ResourceId, Instance
| lookup kind=leftouter SizeReported on ResourceId, Instance
| lookup kind=leftouter Trends on ResourceId, Instance
| extend SizeMbBest = coalesce(SizeMb, iff(LastValue > 0.5 and isnotnull(FreeMbNow), FreeMbNow / (LastValue / 100.0), real(null))),
    SizeBasis = case(isnotnull(SizeMb), "reported", isnotnull(FreeMbNow) and LastValue > 0.5, "derived", "not reported"),
    Level = case(Instance == "_Total (aggregate)", "Aggregate only - not per-volume", VolumeState == "No longer reported", "No longer reported",
        LastValue < DiskLow, "Low free space", "Within threshold")
| sort by (VolumeState == "No longer reported") asc, LastValue asc, Machine asc
| project Machine, Volume = Instance, Level, FreeNowPct = round(LastValue, 1), FreeGb = round(FreeMbNow / 1024.0, 1), SizeGb = round(SizeMbBest / 1024.0, 1), SizeBasis,
    MinPct = round(Minimum, 1), ChangePts = Delta, FreeTrend, ObservedHours, Evidence, LastSample = LastSeen
