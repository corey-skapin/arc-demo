// include: hosts
// Selected machine with its declared parent or guests, side by side. Never added together.
let SelId = toscalar(Hosts | where Machine == '{SelectedHost}' | project ResourceId);
let SelParent = toscalar(Hosts | where Machine == '{SelectedHost}' | project ParentResourceId);
Hosts
| where ResourceId == SelId or (isnotempty(SelParent) and ResourceId == SelParent) or ParentResourceId == SelId
| extend Relation = case(ResourceId == SelId, "selected", ResourceId == SelParent, "its parent", "its guest")
| sort by Relation asc, Machine asc
| project Relation, Machine, Assessment, Evidence = EvidenceState, CpuP95 = round(CpuP95, 1), CpuPeak = round(CpuMax, 1), MemP95 = round(MemP95, 1)
