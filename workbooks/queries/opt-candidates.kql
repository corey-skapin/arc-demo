// include: candidates
// Review candidate matrix, one row per machine. Selecting a row drives the review detail below.
// Each reason is Flagged, Needs evidence or Not flagged; a missing measurement is never read as a clean result.
Candidates
| project Machine, Reasons = iff(ReasonCount == 0, "none flagged", strcat_array(Reasons, ", ")), Evidence = EvidenceQuality,
    Needs = iff(isempty(EvidenceGaps), "nothing further", replace_string(EvidenceGaps, " (not in the parent's own counters)", "")), CpuP95 = round(CpuP95, 1), MemP95 = round(MemP95, 1)
