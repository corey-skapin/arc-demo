// include: hosts
// Sustained pressure versus brief spikes. Sustained = continuous 5-minute intervals at or above the CPU threshold for at least
// the sustained-minutes limit. A spike reaches the threshold but never stays there. Trends keep observed intervals only.
let Trends = Samples
| where Metric == "CPU percent" and isnotnull(Value)
| summarize P95 = percentile(Value, 95), Peak = max(Value) by ResourceId, Bin = bin(TimeGenerated, Step)
| sort by ResourceId asc, Bin asc
| summarize P95Trend = make_list(round(P95, 1)), PeakTrend = make_list(round(Peak, 0)) by ResourceId;
Hosts
| lookup kind=leftouter Trends on ResourceId
| extend MinutesAtOrAbove = coalesce(CpuBreachMinutes, long(0)),
    SharePct = iff(coalesce(CpuObservedHours, 0.0) > 0, round(100.0 * coalesce(CpuBreachMinutes, long(0)) / (CpuObservedHours * 60.0), 1), real(null))
| sort by Rank asc, CpuMax desc, Machine asc
| project Machine, Os, Pattern, Mean = round(CpuMean, 1), P95 = round(CpuP95, 1), Peak = round(CpuMax, 0), MinutesAtOrAbove,
    SharePct, LongestRunMin = coalesce(CpuLongestHotMin, long(0)), P95Trend, PeakTrend, ObservedHours = CpuObservedHours,
    Evidence = EvidenceState, LastSample = HostLastSeen
