// include: series
// Selected machine: mean, 95th percentile and peak CPU per interval. Gaps stay null (unknown, not idle).
Samples
| where Metric == "CPU percent" and isnotnull(Value)
| lookup kind=inner (Machines | project ResourceId, Machine) on ResourceId
| where Machine == '{SelectedHost}'
| make-series Mean = avg(Value) default = real(null), P95 = percentile(Value, 95) default = real(null), Peak = max(Value) default = real(null)
    on TimeGenerated from bin(WindowStart, Step) to bin(WindowEnd, Step) + Step step Step
