// include: candidates, schedule
// Observed activity by local two-hour block of day (average CPU, shared 0-100 scale). A block is the average of every sample in its two local hours, so a block with only
// one reporting hour still shows that hour. Blank cells are blocks with no samples in either hour: unknown, not idle. Idle share is counted per hour by the candidates fragment.
let Clean = (v:real) { iff(isnan(v), real(null), v) };
let Blocks = Samples
| where Metric == "CPU percent" and isnotnull(Value)
| extend Hr = hourofday(TimeGenerated + UtcOffset)
| summarize B00 = round(avgif(Value, Hr in (0, 1)), 0), B01 = round(avgif(Value, Hr in (2, 3)), 0), B02 = round(avgif(Value, Hr in (4, 5)), 0),
    B03 = round(avgif(Value, Hr in (6, 7)), 0), B04 = round(avgif(Value, Hr in (8, 9)), 0), B05 = round(avgif(Value, Hr in (10, 11)), 0),
    B06 = round(avgif(Value, Hr in (12, 13)), 0), B07 = round(avgif(Value, Hr in (14, 15)), 0), B08 = round(avgif(Value, Hr in (16, 17)), 0),
    B09 = round(avgif(Value, Hr in (18, 19)), 0), B10 = round(avgif(Value, Hr in (20, 21)), 0), B11 = round(avgif(Value, Hr in (22, 23)), 0)
    by ResourceId;
Candidates
| lookup kind=leftouter Blocks on ResourceId
| sort by (EnvironmentClass == "Non-production (tag)") desc, Machine asc
// avgif over a block with no samples is NaN: turn it into a null so the cell is blank, not the text NaN.
| project Machine, IdleSharePct,
    B00 = Clean(B00), B01 = Clean(B01), B02 = Clean(B02), B03 = Clean(B03), B04 = Clean(B04), B05 = Clean(B05),
    B06 = Clean(B06), B07 = Clean(B07), B08 = Clean(B08), B09 = Clean(B09), B10 = Clean(B10), B11 = Clean(B11)
