// include: candidates
// Opportunity summary, second row: the two review reasons about the record rather than the sizing of a machine (who owns it, and whether it reports).
// Stale or unowned is never proof that a machine is redundant. Tile text stays short; the tables below name every machine.
let Counts = Candidates
| summarize Ownership = countif(OwnershipState == "Flagged"), OwnershipList = make_list_if(Machine, OwnershipState == "Flagged", 50),
    Stale = countif(StaleState == "Flagged"), StaleList = make_list_if(Machine, StaleState == "Flagged", 50)
| extend K = 1;
let ShortList = (names:dynamic) {
    let sorted = array_sort_asc(names);
    let n = array_length(sorted);
    let both = strcat_array(sorted, ", ");
    case(n == 0, "none", n == 1, tostring(sorted[0]), n == 2 and strlen(both) <= 20, both, strcat(tostring(sorted[0]), " +", tostring(n - 1)))
};
datatable(SortKey:long, Label:string)[
    4, "🏷️ Ownership gaps",
    5, "📡 Not reporting"]
| extend K = 1
| join kind=inner Counts on K
| project SortKey, Label,
    Value = case(SortKey == 4, Ownership, Stale),
    Note = case(SortKey == 4, ShortList(OwnershipList), ShortList(StaleList))
| sort by SortKey asc
| project Label, Value, Note
