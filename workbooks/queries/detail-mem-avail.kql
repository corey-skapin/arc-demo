// include: series
// Selected machine: lowest available memory (MB) per interval, as columns. Gaps stay null (parked time is blank).
Samples
| where Metric == "Available MB" and isnotnull(Value)
| lookup kind=inner (Machines | project ResourceId, Machine) on ResourceId
| where Machine == '{SelectedHost}'
| make-series Lowest = min(Value) default = real(null) on TimeGenerated from bin(WindowStart, DetailStep) to bin(WindowEnd, DetailStep) + DetailStep step DetailStep
| project TimeGenerated, Lowest
