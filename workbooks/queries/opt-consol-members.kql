// include: candidates
// Members of consolidation groups: the low-utilisation machines side by side, each with its own observed peak and size context.
// Never add their figures together; the application owner decides whether any comparison is meaningful.
Candidates
| where UnderState == "Flagged" and Layer != "guest"
| sort by Application asc, Os asc, CpuP95 asc
| project Application, Os, Machine, Size = iff(Vcpu > 0, strcat(tostring(Vcpu), " vCPU / ", Num(MemoryGb, 0), " GB"), "not reported"),
    CpuP95 = round(CpuP95, 1), CpuPeak = round(CpuMax, 1), MemP95 = round(MemP95, 1), Consolidation = ConsolidationState
