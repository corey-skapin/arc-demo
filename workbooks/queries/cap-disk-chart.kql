// include: summary
// Lowest free space (percent) per machine and interval across volumes that are still reporting. Gaps stay null.
// Retired or transient volumes (no longer reported while the machine still reports) are excluded; pseudo mounts are filtered upstream.
Samples
| where Metric == "Disk free percent" and isnotnull(Value)
| lookup kind=inner (Summary | where Metric == "Disk free percent" and VolumeState != "No longer reported" | project ResourceId, Instance, Machine) on ResourceId, Instance
| make-series LowestFreePercent = min(Value) default = real(null) on TimeGenerated from bin(WindowStart, BarStep) to bin(WindowEnd, BarStep) + BarStep step BarStep by Machine
