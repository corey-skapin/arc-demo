// include: candidates, schedule
// The viewer's proposed off-window checked against observed activity. This is evidence for the owner's decision; it never stops anything.
let Evaluated = Samples
| where Metric == "CPU percent" and isnotnull(Value)
| extend Hr = hourofday(TimeGenerated + UtcOffset), Dow = toint(dayofweek(TimeGenerated + UtcOffset) / 1d)
| extend HourOff = ScheduleSet and iff(SchedEnd > SchedStart, Hr >= SchedStart and Hr < SchedEnd, Hr >= SchedStart or Hr < SchedEnd)
| extend InOffWindow = HourOff or (WeekendsOff and (Dow == 0 or Dow == 6))
| summarize OffMinutes = countif(InOffWindow), OffAvg = avgif(Value, InOffWindow), OffP95 = percentile(iff(InOffWindow, Value, real(null)), 95),
    OffPeak = maxif(Value, InOffWindow), OffActive = countif(InOffWindow and Value >= 10.0), OnAvg = avgif(Value, not(InOffWindow)) by ResourceId;
Candidates
| lookup kind=leftouter Evaluated on ResourceId
| extend Reading = case(
    not(ScheduleSet or WeekendsOff), "Set a window above",
    not(AnyTelemetry), "No telemetry: unknown",
    coalesce(OffMinutes, long(0)) == 0, "No samples in the window yet",
    OffActive == 0, "No sample at or above 10% CPU",
    strcat(Num(100.0 * OffActive / OffMinutes, 1), "% of minutes at or above 10%"))
| sort by (EnvironmentClass == "Non-production (tag)") desc, Machine asc
| project Machine, Environment = EnvironmentClass, ProposedOffHoursPerWeek = WeeklyOffHours, OffWindowAvgCpu = round(OffAvg, 1), OffWindowPeakCpu = round(OffPeak, 1), Reading
