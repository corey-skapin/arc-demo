{
  "schemaVersion": 1,
  "description": "Objects a rebuild from main is expected to contain while the estate is Active. {prefix} is the skin name prefix. A rule applies when it has no feature or its feature is enabled (ContainerApps, NestedSql, RealSql, OperationalWorkbooks, Sre, SreAlertGrant).",
  "rules": [
    { "id": "arc/workspace", "group": "arc", "type": "Microsoft.OperationalInsights/workspaces", "name": "law-{prefix}" },
    { "id": "arc/dcr-core", "group": "arc", "type": "Microsoft.Insights/dataCollectionRules", "name": "dcr-arc-demo" },
    { "id": "arc/dcr-vminsights", "group": "arc", "type": "Microsoft.Insights/dataCollectionRules", "name": "dcr-vminsights" },
    { "id": "arc/dcr-changetracking", "group": "arc", "type": "Microsoft.Insights/dataCollectionRules", "name": "dcr-changetracking" },
    { "id": "arc/action-group", "group": "arc", "type": "Microsoft.Insights/actionGroups", "name": "ag-{prefix}" },
    { "id": "arc/heartbeat-alert", "group": "arc", "type": "Microsoft.Insights/scheduledQueryRules", "name": "alert-{prefix}-host-missing-heartbeat" },
    { "id": "arc/workbooks", "group": "arc", "type": "Microsoft.Insights/workbooks", "min": 6 },
    { "id": "arc/operational-workbooks", "feature": "OperationalWorkbooks", "group": "arc", "type": "Microsoft.Insights/workbooks", "tags": { "managedBy": "arc-demo-operational-workbooks" }, "count": 2 },
    { "id": "arc/sql-alert", "feature": "RealSql", "group": "arc", "type": "Microsoft.Insights/scheduledQueryRules", "name": "al-{prefix}-sql-lock-timeout" },
    { "id": "arc/lob-alert", "feature": "Sre", "group": "arc", "type": "Microsoft.Insights/scheduledQueryRules", "name": "alert-{prefix}-lob-arc-app-fault" },
    { "id": "arc/nested-sql-instance", "feature": "NestedSql", "group": "arc", "type": "Microsoft.AzureArcData/sqlServerInstances", "min": 1 },
    { "id": "infra/vnet", "group": "infra", "type": "Microsoft.Network/virtualNetworks", "name": "vnet-{prefix}" },
    { "id": "infra/nsg", "group": "infra", "type": "Microsoft.Network/networkSecurityGroups", "name": "nsg-{prefix}" },
    { "id": "infra/nat-gateway", "group": "infra", "type": "Microsoft.Network/natGateways", "name": "natgw-{prefix}" },
    { "id": "infra/nat-public-ip", "group": "infra", "type": "Microsoft.Network/publicIPAddresses", "name": "pip-natgw-{prefix}" },
    { "id": "infra/one-key-vault", "group": "infra", "type": "Microsoft.KeyVault/vaults", "count": 1 },
    { "id": "infra/no-private-endpoints", "group": "infra", "type": "Microsoft.Network/privateEndpoints", "count": 0 },
    { "id": "infra/no-private-dns-zones", "group": "infra", "type": "Microsoft.Network/privateDnsZones", "count": 0 },
    { "id": "infra/shutdown-schedules", "group": "infra", "type": "Microsoft.DevTestLab/schedules", "min": 1 },
    { "id": "infra/container-app", "feature": "ContainerApps", "group": "infra", "type": "Microsoft.App/containerApps", "name": "ca-{prefix}-fault" },
    { "id": "infra/container-app-alert", "feature": "ContainerApps", "group": "infra", "type": "Microsoft.Insights/metricAlerts", "name": "alert-{prefix}-containerapp-restarts" },
    { "id": "sre/agent", "feature": "Sre", "group": "sre", "type": "Microsoft.App/agents", "count": 1 },
    { "id": "sre/identity", "feature": "Sre", "group": "sre", "type": "Microsoft.ManagedIdentity/userAssignedIdentities", "count": 1 },
    { "id": "sre/app-insights", "feature": "Sre", "group": "sre", "type": "Microsoft.Insights/components", "count": 1 },
    { "id": "subscription/policy-mcsb", "kind": "policy", "name": "mcsb-{prefix}" },
    { "id": "subscription/policy-nist", "kind": "policy", "name": "nist-{prefix}" },
    { "id": "subscription/budget", "kind": "budget", "name": "budget-{prefix}" },
    { "id": "subscription/defender-servers", "kind": "defender", "plan": "VirtualMachines", "tier": "Standard" },
    { "id": "subscription/alert-access-grant", "feature": "SreAlertGrant", "kind": "identityRole", "role": "Monitoring Contributor", "count": 1 },
    { "id": "tenant/onboarding-app", "kind": "onboardingApp" },
    { "id": "tenant/no-residual-credentials", "kind": "noOneDayCredentials" }
  ]
}
