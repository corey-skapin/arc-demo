// Main Bicep template for the Arc demo. Deploys EVERYTHING that can be done
// declaratively. Imperative steps (Arc onboarding, SQL install, agent restarts,
// DCR associations to Arc machines, post-deploy validation) are handled by
// Deploy-ArcDemo.ps1 AFTER this template completes.

targetScope = 'subscription'

@description('Azure region for the demo')
param location string = 'australiaeast'

@description('Resource group for the Arc records, LAW, DCRs, alerts, workbook')
param arcResourceGroup string = 'rg-arc-demo'

@description('Resource group for the backing Azure VMs and infra')
param infraResourceGroup string = 'rg-arc-demo-infra'

@description('Common tags for all resources')
param tags object = {
  owner: 'demo'
  purpose: 'arc-demo'
  costcenter: 'demo'
  env: 'demo'
}

@description('Tenant ID (for Key Vault)')
param tenantId string

@description('Principal ID of the deploying user (for Key Vault RBAC)')
param deployerPrincipalId string

@description('Globally-unique Key Vault name (e.g. kv-arcdemo-xxxxxx)')
param keyVaultName string

@description('Admin username for all VMs')
param adminUsername string = 'azureuser'

@description('Admin password for all VMs (auto-generated by deploy script)')
@secure()
param adminPassword string

@description('On-premises-simulated Arc fleet. Each object defines the VM name, role, OS image, monitoring support, SQL support, ESU eligibility, and deployment mode.')
param onPremFleet array = [
  {
    name: 'win-sql-01'
    role: 'sql'
    osType: 'Windows'
    osTier: 'WS2022'
    imagePublisher: 'MicrosoftWindowsServer'
    imageOffer: 'WindowsServer'
    imageSku: '2022-datacenter-azure-edition'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor'
    supportsAzureMonitor: true
    supportsVmInsights: true
    supportsChangeTracking: true
    supportsSql: true
    esuEligible: false
  }
  {
    name: 'win-sql-02'
    role: 'sql'
    osType: 'Windows'
    osTier: 'WS2019'
    imagePublisher: 'MicrosoftWindowsServer'
    imageOffer: 'WindowsServer'
    imageSku: '2019-datacenter-gensecond'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor'
    supportsAzureMonitor: true
    supportsVmInsights: true
    supportsChangeTracking: true
    supportsSql: true
    esuEligible: false
  }
  {
    name: 'win-app-01'
    role: 'app'
    osType: 'Windows'
    osTier: 'WS2016'
    imagePublisher: 'MicrosoftWindowsServer'
    imageOffer: 'WindowsServer'
    imageSku: '2016-Datacenter'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor'
    supportsAzureMonitor: true
    supportsVmInsights: true
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: true
  }
  {
    name: 'win-app-02'
    role: 'app'
    osType: 'Windows'
    osTier: 'WS2019'
    imagePublisher: 'MicrosoftWindowsServer'
    imageOffer: 'WindowsServer'
    imageSku: '2019-datacenter-gensecond'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor'
    supportsAzureMonitor: true
    supportsVmInsights: true
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: false
  }
  {
    name: 'win-app-03'
    role: 'app'
    osType: 'Windows'
    osTier: 'WS2022'
    imagePublisher: 'MicrosoftWindowsServer'
    imageOffer: 'WindowsServer'
    imageSku: '2022-datacenter-azure-edition'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor'
    supportsAzureMonitor: true
    supportsVmInsights: true
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: false
  }
  {
    name: 'lnx-app-01'
    role: 'app'
    osType: 'Linux'
    osTier: 'Ubuntu22.04'
    imagePublisher: 'Canonical'
    imageOffer: '0001-com-ubuntu-server-jammy'
    imageSku: '22_04-lts-gen2'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor-no-vmi-map'
    supportsAzureMonitor: true
    supportsVmInsights: false
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: false
  }
  {
    name: 'lnx-app-02'
    role: 'app'
    osType: 'Linux'
    osTier: 'Ubuntu22.04'
    imagePublisher: 'Canonical'
    imageOffer: '0001-com-ubuntu-server-jammy'
    imageSku: '22_04-lts-gen2'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor-no-vmi-map'
    supportsAzureMonitor: true
    supportsVmInsights: false
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: false
  }
  {
    name: 'lnx-app-03'
    role: 'app'
    osType: 'Linux'
    osTier: 'Ubuntu22.04'
    imagePublisher: 'Canonical'
    imageOffer: '0001-com-ubuntu-server-jammy'
    imageSku: '22_04-lts-gen2'
    imageVersion: 'latest'
    deploymentMode: 'azure-vm'
    monitorTier: 'full-monitor-no-vmi-map'
    supportsAzureMonitor: true
    supportsVmInsights: false
    supportsChangeTracking: true
    supportsSql: false
    esuEligible: false
  }
]

@description('VM SKU')
param vmSize string = 'Standard_B2as_v2'

@description('Auto-shutdown time (HHmm)')
param autoShutdownTime string = '1900'

@description('Auto-shutdown timezone (.NET timezone ID)')
param autoShutdownTimezone string = 'Cen. Australia Standard Time'

@description('Email address for budget + alert notifications')
param adminEmail string

@description('Monthly budget amount in subscription currency')
param budgetAmount int = 200

@description('Name prefix for derived resource names (vnet, nsg, ag, alert)')
param namePrefix string = 'arc-demo'

@description('Deploy the on-premises-simulated Azure VMs and Arc-enable them through the deployment script.')
param deployArcOnPrem bool = true

@description('Deploy the optional Azure-native VM workload. Placeholder only until the workload module is implemented.')
param deployAzureVMs bool = false

@description('Deploy the optional Container Apps workload. Placeholder only until the workload module is implemented.')
param deployContainerApps bool = false

@description('Deploy the optional AKS workload with Container Insights, a sample workload, and a pod restart alert.')
param deployAks bool = false

@description('Optional existing NAT Gateway resource ID to attach to the subnet. Pass through from the deploy script so re-runs preserve the Activate-ArcDemo NAT GW attachment. Leave empty on fresh deploys.')
param existingNatGatewayId string = ''

@description('Existing budget start date (YYYY-MM-01) to preserve on re-runs. Defaults to the first of the current UTC month for fresh deploys.')
param existingBudgetStartDate string = utcNow('yyyy-MM-01')

resource rgArc 'Microsoft.Resources/resourceGroups@2024-11-01' = {
  name: arcResourceGroup
  location: location
  tags: tags
}

resource rgInfra 'Microsoft.Resources/resourceGroups@2024-11-01' = {
  name: infraResourceGroup
  location: location
  tags: tags
}

// ----- Workspace + DCRs + alerts (in the Arc RG) -----

module workspaceMod 'modules/workspace.bicep' = {
  name: 'workspace-deploy'
  scope: rgArc
  params: {
    location: location
    tags: tags
    workspaceName: 'law-${namePrefix}'
  }
}

module dcrsMod 'modules/dcrs.bicep' = {
  name: 'dcrs-deploy'
  scope: rgArc
  params: {
    location: location
    tags: tags
    workspaceId: workspaceMod.outputs.workspaceId
    workspaceName: workspaceMod.outputs.workspaceName
  }
}

module alertsMod 'modules/alerts.bicep' = {
  name: 'alerts-deploy'
  scope: rgArc
  params: {
    location: location
    tags: tags
    workspaceId: workspaceMod.outputs.workspaceId
    adminEmail: adminEmail
    namePrefix: namePrefix
  }
}

// ----- Network + KV + VMs (in the Infra RG) -----

module networkMod 'modules/network.bicep' = {
  name: 'network-deploy'
  scope: rgInfra
  params: {
    location: location
    tags: tags
    namePrefix: namePrefix
    existingNatGatewayId: existingNatGatewayId
  }
}

module kvMod 'modules/keyvault.bicep' = {
  name: 'kv-deploy'
  scope: rgInfra
  params: {
    location: location
    tags: tags
    vaultName: keyVaultName
    tenantId: tenantId
    deployerPrincipalId: deployerPrincipalId
  }
}

var requestedOnPremVms = [for vm in onPremFleet: union(vm, {
  deployed: vm.deploymentMode == 'azure-vm'
  arcControlPlaneCoverage: [
    'inventory'
    'update-manager-assessment'
    'defender-for-servers'
    'machine-configuration'
    'esu-eligibility-surfacing'
  ]
})]

module vmMods 'modules/vm.bicep' = [for vm in requestedOnPremVms: if (deployArcOnPrem && vm.deployed) {
  name: 'vm-${vm.name}'
  scope: rgInfra
  params: {
    vmName: vm.name
    location: location
    tags: union(tags, {
      role: vm.role
      ostype: toLower(vm.osType)
      osTier: toLower(vm.osTier)
      monitorTier: vm.monitorTier
      esuEligible: vm.esuEligible ? 'true' : 'false'
    })
    vmSize: vmSize
    subnetId: networkMod.outputs.subnetId
    adminUsername: adminUsername
    adminPassword: adminPassword
    imagePublisher: vm.imagePublisher
    imageOffer: vm.imageOffer
    imageSku: vm.imageSku
    imageVersion: vm.imageVersion
    osType: vm.osType
    autoShutdownTime: autoShutdownTime
    autoShutdownTimezone: autoShutdownTimezone
  }
}]

module azureVmsMod 'modules/azure-vms.bicep' = if (deployAzureVMs) {
  name: 'azure-vms-deploy'
  scope: rgInfra
  params: {
    location: location
    tags: tags
    namePrefix: namePrefix
  }
}

module containerAppsMod 'modules/container-apps.bicep' = if (deployContainerApps) {
  name: 'container-apps-deploy'
  scope: rgInfra
  params: {
    location: location
    tags: tags
    namePrefix: namePrefix
  }
}

module aksMod 'modules/aks.bicep' = if (deployAks) {
  name: 'aks-deploy'
  scope: rgInfra
  params: {
    location: location
    tags: tags
    namePrefix: namePrefix
    workspaceId: workspaceMod.outputs.workspaceId
    actionGroupId: alertsMod.outputs.actionGroupId
  }
}

// ----- Subscription-scoped pieces -----

module defenderMod 'modules/defender.bicep' = {
  name: 'defender-deploy'
}

module policyMod 'modules/policy.bicep' = {
  name: 'policy-deploy'
  params: {
    location: location
    namePrefix: namePrefix
  }
}

module budgetMod 'modules/budget.bicep' = {
  name: 'budget-deploy'
  params: {
    amount: budgetAmount
    adminEmail: adminEmail
    arcResourceGroup: arcResourceGroup
    infraResourceGroup: infraResourceGroup
    namePrefix: namePrefix
    startDate: existingBudgetStartDate
  }
}

// ----- Outputs -----

var outputOnPremVms = deployArcOnPrem ? requestedOnPremVms : []
var outputVmNames = [for vm in outputOnPremVms: vm.deployed ? vm.name : '']

output arcResourceGroup string = rgArc.name
output infraResourceGroup string = rgInfra.name
output workspaceId string = workspaceMod.outputs.workspaceId
output workspaceCustomerId string = workspaceMod.outputs.customerId
output keyVaultName string = kvMod.outputs.vaultName
output subnetId string = networkMod.outputs.subnetId
output vmNames array = outputVmNames
output vmFleet array = [for vm in outputOnPremVms: {
  name: vm.name
  role: vm.role
  osType: vm.osType
  osTier: vm.osTier
  imagePublisher: vm.imagePublisher
  imageOffer: vm.imageOffer
  imageSku: vm.imageSku
  imageVersion: vm.imageVersion
  deploymentMode: vm.deploymentMode
  deployed: vm.deployed
  monitorTier: vm.monitorTier
  supportsAzureMonitor: vm.supportsAzureMonitor
  supportsVmInsights: vm.supportsVmInsights
  supportsChangeTracking: vm.supportsChangeTracking
  supportsSql: vm.supportsSql
  esuEligible: vm.esuEligible
  arcControlPlaneCoverage: vm.arcControlPlaneCoverage
}]
output dcrCoreId string = dcrsMod.outputs.dcrCoreId
output dcrVmiId string = dcrsMod.outputs.dcrVmiId
output dcrCtId string = dcrsMod.outputs.dcrCtId
output actionGroupId string = alertsMod.outputs.actionGroupId
